rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User documents vault
    match /users/{userId}/documents/{documentId} {
      allow read, write, delete: if isOwner(userId);
    }

    // Prepaid One-Time Balance Wallet & Ledger (Server-Authoritative ONLY)
    match /users/{userId}/wallet/{walletDoc} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/wallet_transactions/{txId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/verified_purchases/{token} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
